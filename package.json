		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.3",
		"framer-motion": "^12.0.0",
		"lucide-react": "^0.576.0",
		"next": "16.0.10",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7"
